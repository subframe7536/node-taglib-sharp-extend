{
  "name": "node-taglib-sharp-extend",
  "version": "0.4.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd ./packages/node-taglib-sharp-extend && tsdown --watch",
    "build": "cd ./packages/node-taglib-sharp-extend && bun run build",
    "play": "bun run build && cd ./packages/playground && bun run dev",
    "qa": "oxlint --fix && oxfmt && tsc --noEmit",
    "release": "bun run build && bun run test && bumpp package.json ./packages/node-taglib-sharp-extend/package.json --all",
    "test": "vitest --run"
  },
  "dependencies": {
    "@subframe7536/iconv-lite": "^0.8.1",
    "buffer-es6": "^4.9.3",
    "text-decoder": "^1.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@subf/config": "^0.2.1",
    "@subframe7536/type-utils": "^0.2.0",
    "@types/node": "^22.18.6",
    "bumpp": "^10.2.3",
    "fast-base64": "^0.1.8",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "unplugin-inline-enum": "^0.6.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "magic-string": ">=0.30"
  },
  "peerDependenciesMeta": {
    "magic-string": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.7.0"
  }
}
