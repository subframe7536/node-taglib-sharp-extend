{
  "name": "node-taglib-sharp-extend",
  "version": "0.4.1",
  "description": "read and write audio file metadata in nodejs / browser(memory)",
  "keywords": [
    "music-metadata"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/node-taglib-sharp-extend.git"
  },
  "files": [
    "dist",
    "polyfills"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json",
    "./buffer": "./polyfills/buffer-es6.js",
    "./string-decoder": "./polyfills/string-decoder.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "play": "cd ./playground && bun run dev",
    "qa": "oxlint --fix && oxfmt && tsc --noEmit",
    "release": "bun run build && bumpp --all && npm publish",
    "test": "vitest --run"
  },
  "dependencies": {
    "@subframe7536/iconv-lite": "^0.8.1",
    "buffer-es6": "^4.9.3",
    "text-decoder": "^1.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@subf/config": "^0.2.0",
    "@subframe7536/type-utils": "^0.2.0",
    "@types/node": "^22.18.6",
    "bumpp": "^10.2.3",
    "fast-base64": "^0.1.8",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "unplugin-inline-enum": "^0.6.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "magic-string": ">=0.30"
  },
  "peerDependenciesMeta": {
    "magic-string": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.7.0"
  }
}
